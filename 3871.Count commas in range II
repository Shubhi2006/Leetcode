class Solution {
    public long countCommas(long n) {
        long count = 0;
        long start = 1000;
        long commas = 1;

        while (start <= n) {
            long end = start * 1000 - 1;

            // overflow se bachne ke liye
            if (end < start || end > n) {
                end = n;
            }

            count += (end - start + 1) * commas;

            if (end == n) {
                break;
            }

            start *= 1000;
            commas++;
        }

        return count;
        
    }
}
