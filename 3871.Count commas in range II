class Solution {
    public long countCommas(long n) {
        long count=0;
        if (n < 1000) {
            return 0;
        }
        if (n < 1000000) {
            return n - 1000 + 1;
        }
        count += 999999 - 1000 + 1;
        if (n < 1000000000L) {
            count += (n - 1000000 + 1) * 2;
            return count;
        }
        count += (999999999L - 1000000 + 1) * 2;
        if (n < 1000000000000L) {
            count += (n - 1000000000L + 1) * 3;
            return count;
        }
        return count + (n - 1000000000000L + 1) * 4;
        
    }
}
