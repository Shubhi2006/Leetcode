class Solution {
    public int lengthOfLongestSubstring(String s) {
        HashSet<Character> set=new HashSet<>();
        int count=0;
        for(int i=0;i<s.length();i++){
            int max=1;
            set.add(s.charAt(i));
            for(int j=i+1;j<s.length();j++){
                if(set.contains(s.charAt(j))){
                    set.clear();
                    break;
                }
                else{
                    max++;
                    set.add(s.charAt(j));
                }
            }
            count=Math.max(count,max);
        }
         return count;
    }
}
