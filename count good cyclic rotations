class Solution {
    public int countGoodRotations(int[] nums) {
        long leftsum=0;
        long rightsum=0;
        int len=nums.length;
        int left=0;
        int right=len/2;
        int count=0;
        for(int i=0;i<len/2;i++){
            leftsum+=nums[i];
            rightsum+=nums[len/2+i];
        }
        while(left<nums.length){
            if(leftsum>rightsum){
               count++; 
            }
            leftsum=leftsum+nums[right%len]-nums[left];
            rightsum=rightsum+nums[left]-nums[right%len];
            left++;
            right++;
        }
        return count;
    }
}
