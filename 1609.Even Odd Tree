class Solution {
    public boolean isEvenOddTree(TreeNode root) {

        if (root == null) {
            return true;
        }

        Queue<TreeNode> que = new LinkedList<>();
        que.add(root);

        int level = 0;

        while (!que.isEmpty()) {

            int size = que.size();

          
            int prev;

            if (level % 2 == 0) {
               
                prev = Integer.MIN_VALUE;
            } else {
                
                prev = Integer.MAX_VALUE;
            }

            for (int i = 0; i < size; i++) {

                TreeNode curr = que.poll();

                if (level % 2 == 0) {

                    if (curr.val % 2 == 0 || curr.val <= prev) {
                        return false;
                    }

                }
                
                else {

                    if (curr.val % 2 != 0 || curr.val >= prev) {
                        return false;
                    }
                }

                prev = curr.val;

                if (curr.left != null) {
                    que.add(curr.left);
                }

                if (curr.right != null) {
                    que.add(curr.right);
                }
            }
            level++;
        }
        return true;
    }
}
