class Solution {
    public int[] searchRange(int[] nums, int target) {
        int []ans={-1,-1};
        int left=0;
        int right=nums.length-1;
        while(left<=right){
            int mid=left+(right-left)/2;
            if(nums[mid]==target){
                ans[0]=mid;
                right=mid-1;
            }
            else if(nums[mid]>target){
                right=mid-1;
            }
            else if(nums[mid]<target){
                left=mid+1;
            }
        }
        int start=0;
        int end=nums.length-1;
        while(start<=end){
            int mid2=start+(end-start)/2;
            if(nums[mid2]==target){
                ans[1]=mid2;
                start=mid2+1;
            }
            else if(nums[mid2]>target){
                end=mid2-1;
            }
            else if(nums[mid2]<target){
                start=mid2+1;
            }
        }
        return ans;
    }
}
