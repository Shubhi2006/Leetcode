class MyHashMap {
    int[] present;
    public MyHashMap() {
        present=new int[1000001];
        Arrays.fill(present,-1);
    }
    
    public void put(int key, int value) {
        present[key]=value;
    }
    
    public int get(int key) {
        return present[key];
    }
    
    public void remove(int key) {
        present[key]=-1;
    }
}
