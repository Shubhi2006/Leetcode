class Solution {
    public long maxAlternatingSum(int[] nums) {
        for(int i=0;i<nums.length;i++){
            nums[i]=nums[i]*nums[i];
        }
        Arrays.sort(nums);
        long sum=0;
        int left=0;
        int right=nums.length-1;
        while(left<right){
            sum+=nums[right]-nums[left];
            right--;
            left++;
        }
        if(nums.length%2!=0){
            sum+=nums[left];
        }
        return sum;

    }
}
