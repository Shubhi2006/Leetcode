class Solution {
    public void sortColors(int[] nums) {
        for(int i=0;i<nums.length;i++){
            int key=i;
            for(int j=i+1;j<nums.length;j++){
                if(nums[j]<nums[key]){
                    key=j;
                }
            }
            int temp=nums[i];
            nums[i]=nums[key];
            nums[key]=temp;
        }
        return;
    }
}
