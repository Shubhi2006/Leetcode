class Solution {
    public ListNode swapNodes(ListNode head, int k) {
        ListNode temp=head;
        int count=0;
        while(temp!=null){
            count++;
            temp=temp.next;
        }
        int i=1;
        ListNode right=head;
        while(i<=count-k){
            right=right.next;
            i++;
        }
        ListNode left=head;
        int j=1;
        while(j<k){
            left=left.next;
            j++;    
        }
        int value=left.val;
        left.val=right.val;
        right.val=value;
        return head;

    }
}
