class Solution {
    public void nextPermutation(int[] nums) {
        int i=nums.length-2;
        while(i>=0 && nums[i]>=nums[i+1]){
            i--;
        }
        if(i<0){
            int left=0;
            int right=nums.length-1;
            while(left<=right){
                int tem=nums[left];
                nums[left]=nums[right];
                nums[right]=tem;
                left++;
                right--;
            }
        }
        else{
            int j=nums.length-1;
            while(nums[i]>=nums[j]){
                j--;
            }
            int temp=nums[i];
            nums[i]=nums[j];
            nums[j]=temp;
        }
        int k=i+1;
        int l=nums.length-1;
        while(k<l){
            if(nums[k]>nums[l]){
                int temp2=nums[k];
                nums[k]=nums[l];
                nums[l]=temp2;
            }
            k++;
            l--;
        }
        return;
    }
}
