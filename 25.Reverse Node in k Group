class Solution {
    public static ListNode reverseknode(ListNode head,int k,int length){
        if(length<k){
            return head;
        }
        ListNode curr;
        ListNode prev=null;
        ListNode next=null;
        curr=head;
        int count=0;
        while(curr!=null && count<k){
            next=curr.next;
            curr.next=prev;
            prev=curr;
            curr=next;
            count++;
        }
        if(next!=null){
            head.next=reverseknode(next,k,length-k);
        }
        return prev;
    }
    public static int length(ListNode head){
        ListNode temp=head;
        int count=0;
        while(temp!=null){
            count++;
            temp=temp.next;
        }
        return count;
    }
    public ListNode reverseKGroup(ListNode head, int k) {
        int length=length(head);
        return reverseknode(head,k,length);
    }
}
