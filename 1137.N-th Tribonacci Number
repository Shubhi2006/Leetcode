class Solution {
    public int tribonacci(int n) {
        if(n==0 || n==1){
            return n;
        }
        if(n==2){
            return 1;
        }
        int temp0=0;
        int temp1=1;
        int temp2=1;
        for(int i=3;i<=n;i++){
            int temp=temp1+temp2+temp0;
            temp0=temp1;
            temp1=temp2;
            temp2=temp;
        }
        return temp2;
    }
}
