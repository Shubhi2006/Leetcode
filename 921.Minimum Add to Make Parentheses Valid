class Solution {
    public int minAddToMakeValid(String s) {
        Stack<Character>stack=new Stack<>();
        for(int i=0;i<s.length();i++){
            if(!stack.isEmpty() && stack.peek()=='('&& stack.peek()!=s.charAt(i)){
                stack.pop();
            }
            else{
                stack.push(s.charAt(i));
            }
            
        }
        int count=0;
        while(!stack.isEmpty()){
            stack.pop();
            count++;
        }
        return count;
    }
}
