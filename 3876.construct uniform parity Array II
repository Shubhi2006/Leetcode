class Solution {
    public boolean uniformArray(int[] nums1) {
        int neven=0;
        int nodd=0;
        Arrays.sort(nums1);
        int []nums2=new int[nums1.length];
        for(int i=0;i<nums1.length;i++){
            if(nums1[i]%2==0){
                neven++;
            }
            else{
                nodd++;
            }
        }
        if(neven==0 ||nodd==0){
            return true;
        }
        if(nums1[0]%2==0){
            return false;
        }
        return true;
    }
}
