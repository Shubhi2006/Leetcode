class Solution {
    public static void helper(int[]nums,List<List<Integer>> ans,List<Integer>curr,boolean[] arr){
        if(curr.size()==nums.length){
            ans.add(new ArrayList<>(curr));
            return ;
        }
        for(int i=0;i<nums.length;i++){
            if(arr[i]){
                continue;
            }
            curr.add(nums[i]);
            arr[i]=true;
            helper(nums,ans,curr,arr);
            curr.remove(curr.size()-1);
            arr[i]=false;

        }
    }
    public List<List<Integer>> permute(int[] nums) {
        List<List<Integer>> ans=new ArrayList<>();
        boolean[] arr=new boolean[nums.length];
        helper(nums,ans,new ArrayList<>(),arr);
        return ans;
    }
}
