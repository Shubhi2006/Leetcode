class Solution {
    int p;
    public TreeNode buildUtil(int[]inorder,int[]postorder,int left,int right){
        if(left>right){
            return null;
        }
        int val=postorder[p];
        p--;
        TreeNode root=new TreeNode(val);
        int pos=left;
        while(val !=inorder[pos]){
            pos++;
        }
        root.right=buildUtil(inorder,postorder,pos+1,right);
        root.left=buildUtil(inorder,postorder,left,pos-1);
        
        return root;

    }
    public TreeNode buildTree(int[] inorder, int[] postorder) {
        p=postorder.length-1;
        return buildUtil(inorder,postorder,0,postorder.length-1);
    }
}
