class Solution {
    public boolean judgeSquareSum(int c) {
        long range=(int)Math.sqrt(c);
        long left=0;
        long right=range;
        while(left<=right){
            if(((left*left)+(right*right))==c){
                return true;
            }
            else if(((left*left)+(right*right))>c){
                right--;
            }
            else{
                left++;
            }
        }
        return false;

    }
}
