class Solution {
    public int[][] matrixReshape(int[][] mat, int r, int c) {
        if(mat.length *mat[0].length!=r*c){
            return mat;
        }
        int[][]ans=new int[r][c];
        int []val=new int[r*c];
        int k=0;
        for(int i=0;i<mat.length;i++){
            for(int j=0;j<mat[0].length;j++){
                val[k++]=mat[i][j];
            }  
        }
        int index=0;
        for(int row=0;row<r;row++){
            for(int col=0;col<c;col++){
                ans[row][col]=val[index++];
            }  
        }
        return ans;
    }
}
