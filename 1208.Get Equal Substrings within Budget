class Solution {
    public int equalSubstring(String s, String t, int maxCost) {
        int left=0;
        int right=0;
        int max=0;
        int length=0;
        while(right<s.length()){
            max+=Math.abs(s.charAt(right)-t.charAt(right));
            while(max>maxCost){
                max-=Math.abs(s.charAt(left)-t.charAt(left));
                left++;
            }
            length=Math.max(length,right-left+1);
            right++;
        }
        return length;
    }
}
