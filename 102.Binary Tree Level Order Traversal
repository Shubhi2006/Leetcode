class Solution {
    public List<List<Integer>> levelOrder(TreeNode root) {
        List<List<Integer>>ans=new ArrayList<>();
        if(root==null){
            return ans;
        }
        Queue<TreeNode> que=new LinkedList<>();
        que.add(root);
        while(!que.isEmpty()){
            int size=que.size();
            List<Integer>subans=new ArrayList<>();
            for(int i=0;i<size;i++){
                TreeNode curr=que.poll();
                subans.add(curr.val);
                if(curr.left !=null){
                    que.add(curr.left);
                }
                if(curr.right !=null){
                    que.add(curr.right);
                }
            }
            ans.add(subans);
            
        }
        return ans;
    }
}
