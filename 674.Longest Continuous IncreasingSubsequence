class Solution {
    public int findLengthOfLCIS(int[] nums) {
        int left=0;
        int right=1;
        int maxcount=1;
        int count=1;
        while(right<nums.length){
            if(nums[right]>nums[left]){
                count++;
                right++;
                left++;
                maxcount=Math.max(maxcount,count);
            }
            else{
                left=right;
                right++;
                count=1;
            }
        }
        return maxcount;
    }
}
