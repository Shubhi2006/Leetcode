class Solution {
    int ans=0;
    public int dfs(TreeNode root,int left,int right){
        if(root==null){
            return 0;
        }
        ans=Math.max(ans,Math.max(left,right));
        dfs(root.left,right+1,0);
        dfs(root.right,0,left+1);
        
        return ans;
    }
    public int longestZigZag(TreeNode root) {
        dfs(root,0,0);
        return ans;
    }
}
