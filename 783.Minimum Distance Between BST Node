class Solution {
    public int minDiffInBST(TreeNode root) {
        int ans=Integer.MAX_VALUE;
        TreeNode prev=null;
        Stack<TreeNode>stack=new Stack<>();
        while(!stack.isEmpty() || root!=null){
            while(root!=null){
                stack.add(root);
                root=root.left;
            }
            root=stack.pop();
            if(prev!=null){
                ans=Math.min(ans,root.val-prev.val);
            }
            prev=root;
            root=root.right;
        }
        return ans;
    }
}
