class Solution {
    public static int count=0;
    public int totalNQueens(int n) {
        count=0;
        String[][]board=new String[n][n];
        for(int i=0;i<n;i++){
            for(int j=0;j<n;j++){
                board[i][j]=".";
            }
        }
        solve(board,0);
        return count;
        
    }
    public static void solve(String[][]board,int row){
        if(row==board.length){
            count++;
            return;
        }
        for(int i=0;i<board.length;i++){
            if(issafe(board,row,i)){
                board[row][i]="Q";
                solve(board,row+1);
                board[row][i]=".";
            }
        }

    }
    public static boolean issafe(String[][]board,int row,int col){
            for(int i=row-1;i>=0;i--){
                if(board[i][col].equals("Q")){
                    return false;
                }
            }
            int i;int j;
            for(i=row-1,j=col-1;i>=0 && j>=0;i--,j--){
                if(board[i][j].equals("Q")){
                    return false;
                }
            }
            for(i=row-1,j=col+1;i>=0 && j<board.length;i--,j++){
                if(board[i][j].equals("Q")){
                    return false;
                }
            }
            return true;
    }
}
