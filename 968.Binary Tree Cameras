class Solution {
    private int helper(TreeNode root){
        if(root==null){
            return -1;
        }
        int left=helper(root.left);
        int right=helper(root.right);
        if(left==0 || right==0){
            count++;
            return 1;
        }
        if(left==1 || right==1){
            return -1;
        }
        return 0;
    }
    private int count=0;
    public int minCameraCover(TreeNode root) {
        count=0;
        if(helper(root)==0){
            count++;
        }
        return count;
    }
}
