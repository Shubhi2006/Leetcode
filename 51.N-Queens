class Solution {
    public static List<List<String>>result=new ArrayList<>();
    public List<List<String>> solveNQueens(int n) {
        result.clear();
        String[][]board=new String[n][n];
        for(int i=0;i<n;i++){
            for(int j=0;j<n;j++){
                board[i][j]=".";
            }
        }
        nqueen(board,0);
        return result;   
    }
    public static void nqueen(String[][]board,int row){
        if(row==board.length){
            result.add(putboard(board));
            return;
        }
        for(int i=0;i<board.length;i++){
            if(issafe(board,row,i)){
                board[row][i]="Q";
                nqueen(board,row+1);
                board[row][i]=".";
            }    
        }
    }
    public static List<String> putboard(String[][]board){
        List<String> ans=new ArrayList<>();
        for(int i=0;i<board.length;i++){
            String sub="";
            for(int j=0;j<board[0].length;j++){
                sub+=board[i][j];
            }
            ans.add(sub);
        }
        return ans;
    }
    public static boolean issafe(String[][]board ,int row,int col){
        for(int i=row-1;i>=0;i--){
            if(board[i][col].equals("Q")){
                return false;
            }
        }
        int i;
        int j;
        for(i=row-1,j=col-1;i>=0 && j>=0;i--,j--){
            if(board[i][j].equals("Q")){
                return false;
            }
        }
        for(i=row-1,j=col+1;i>=0 && j<board[0].length;i--,j++){
            if(board[i][j].equals("Q")){
                return false;
            }
        }
        return true;
    }
}
