class Solution {
    public ListNode deleteMiddle(ListNode head) {
        if(head==null || head.next==null){
            return null;
        }
        ListNode temp=head;
        int count=0;
        while(temp!=null){
            temp=temp.next;
            count++;
        }
        int i=1;
        ListNode mid=head;
        while(i<(count/2)){
            mid=mid.next;
            i++;
        }
        mid.next=mid.next.next;
        return head;

    }
}
