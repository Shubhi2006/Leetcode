class Solution {
    public int dominantIndex(int[] nums) {
        int first = Integer.MIN_VALUE;
        int second = Integer.MIN_VALUE;

        for (int i = 0; i < nums.length; i++) {
            if (nums[i] > first) {
                second = first;
                first = nums[i];
            } else if (nums[i] > second) {
                second = nums[i];
            }
        }

        if (first >= 2 * second) {
            for (int j = 0; j < nums.length; j++) {
                if (nums[j] == first) {
                    return j;
                }
            }
        }

        return -1;
    }
}
