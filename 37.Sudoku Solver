class Solution {
    public void solveSudoku(char[][] board) {
        solve(board);
        return;
    }
    public static boolean solve(char[][]board){
        for(int i=0;i<board.length;i++){
            for(int j=0;j<board[0].length;j++){
                if(board[i][j]=='.'){
                    for(char k='1';k<='9';k++){
                        if(issafe(board,i,j,k)){
                            board[i][j]=(char)k;
                            if(solve(board)){
                                return true;
                            }
                            board[i][j]='.';
                        }
                    }
                    return false;
                }
            }
        }
        return true;
    }
    public static boolean issafe(char[][]board,int row,int col,char digit){
        for(int i=0;i<9;i++){
            if(board[row][i]==digit){
                return false;
            }
            if(board[i][col]==digit){
                return false;
            }
            int newrow=3*(row/3)+i/3;
            int newcol=3*(col/3)+i%3;
            if(board[newrow][newcol]==digit){
                return false;
            }
        }
        return true;
    }
}
