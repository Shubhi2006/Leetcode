class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {
        int i=0;
        int j=0;
        int len=(nums1.length+nums2.length);
        double median=0.0;
        int previous=0;
        int current=0;
        int count=len/2;
        while(i<nums1.length && j<nums2.length && count>=0){
            previous=current;
            if(nums1[i]<nums2[j]){
                current=nums1[i];
                i++;
            }
            else{
                current=nums2[j];
                j++;
            }
            count--;
        }
        while(i<nums1.length && count>=0){
            previous=current;
            current=nums1[i];
            i++;
            count--;
        }
        while(j<nums2.length && count>=0){
            previous=current;
            current=nums2[j];
            j++;
            count--;
        }
        if(len%2==0){
            median=(current+previous)/2.0;
        }
        else{
            median=current;
        }
    return median; 
    }
}
