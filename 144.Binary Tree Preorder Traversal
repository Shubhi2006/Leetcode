class Solution {
    public List<Integer> preorder(TreeNode root,List<Integer>arr){
        if(root==null){
            return arr;
        }
        arr.add(root.val);
        preorder(root.left,arr);
        preorder(root.right,arr);
        return arr;
    }
    public List<Integer> preorderTraversal(TreeNode root) {
        List<Integer>arr=new ArrayList<>();
        preorder(root,arr);
        return arr;
    }
}
