class Solution {
    public int findLHS(int[] nums) {
        Arrays.sort(nums);
        int max=0;
        for(int i=0;i<nums.length;i++){
            int right=nums.length-1;
            while(i<right){
                if(nums[right]-nums[i]!=1){
                    right--;
                }
                else{
                    max=Math.max(max,right-i+1);
                    break;
                }
            }
        }
        return max;
    }
}
