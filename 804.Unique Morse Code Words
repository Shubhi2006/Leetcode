class Solution {
    public int uniqueMorseRepresentations(String[] words) {
        String[] conver={".-","-...","-.-.","-..",".","..-.","--.","....","..",".---","-.-",".-..","--","-.","---",".--.","--.-",".-.","...","-","..-","...-",".--","-..-","-.--","--.."};
        HashSet<String> set=new HashSet<>();
        for(String ele:words){
            String word="";
            for(int i=0;i<ele.length();i++){
                word+=conver[ele.charAt(i)-'a'];
            }
            set.add(word);
        }
        return set.size();
    }
}
