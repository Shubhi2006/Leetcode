class Solution {
    public List<Long> mergeAdjacent(int[] nums) {
        List<Long>arr=new ArrayList<>();
        Stack<Long>stack=new Stack<>();
        for(int i=0;i<nums.length;i++){
            long curr=nums[i];
            while(!stack.isEmpty()&& stack.peek()==curr){
                curr=stack.pop()+curr;
            }
            stack.push(curr);

        }
        while(!stack.isEmpty()){
            arr.add(stack.pop());
        }
        Collections.reverse(arr);
        return arr;


    }
}
