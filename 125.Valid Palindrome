class Solution {
    public boolean isPalindrome(String s) {
        String str=s.toLowerCase();
        int left=0;
        int right=s.length()-1;
        while(left<right){
            if(!(str.charAt(left)>=97 && str.charAt(left)<=122) && !('0'<=str.charAt(left) && str.charAt(left)<='9')){
                left++;
            }
            else if(!(str.charAt(right)>=97 && str.charAt(right)<=122)&& !('0'<=str.charAt(right) && str.charAt(right)<='9')){
                right--;
            }
            else{
                if(str.charAt(left)!=str.charAt(right)){
                    return false;
                }
                left++;
                right--;
            }

            
        }
        return true;
    }
}
