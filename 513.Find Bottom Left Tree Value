class Solution {
    public int findBottomLeftValue(TreeNode root) {
        int ans=root.val;
        if(root==null){
            return ans;
        }
        Queue<TreeNode>que=new LinkedList<>();
        que.add(root);
        while(!que.isEmpty()){
            int size=que.size();
            for(int i=0;i<size;i++){
                if(i==0){
                    ans=que.peek().val;
                }
                TreeNode curr=que.poll();
                if(curr.left!=null){
                    que.add(curr.left);
                }
                if(curr.right!=null){
                    que.add(curr.right);
                }
            }
            
        }
        return ans;
    }
}
