class Solution {
    public int findKthLargest(int[] nums, int k) {
        PriorityQueue<Integer> pq= new PriorityQueue<>(Collections.reverseOrder());
        for(int i=0;i<nums.length;i++){
            pq.add(nums[i]);
        }
        int ans=0;
        for(int j=k;j>0;j--){
            ans=pq.peek();
            pq.poll();
        }
        return ans;
    }
}
