class Solution {
    public void dfs(List<List<Integer>> rooms,int[]vis,int curr){
        vis[curr]=1;
        for(int i=0;i<rooms.get(curr).size();i++){
            int neighbour=(int)rooms.get(curr).get(i);
            if(vis[neighbour]==0){
                dfs(rooms,vis,neighbour);
            }
        }
    }
    public boolean canVisitAllRooms(List<List<Integer>> rooms) {
        int v=rooms.size();
        int[]visited=new int[v];
        dfs(rooms,visited,0);
        for(int i=0;i<v;i++){
            if(visited[i]==0){
                return false;
            }
        }
        return true;
    }
}
