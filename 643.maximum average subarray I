import java.util.*;
class Solution {
    public double findMaxAverage(int[] nums, int k) {
        int window=0;
        for(int i=0;i<k;i++){
            window+=nums[i];
        }
        int sum=window;
        for(int i=k;i<nums.length;i++){
            sum=sum+nums[i]-nums[i-k];
            window=Math.max(window,sum);
        }
        return window/(double)k;
    }
}
