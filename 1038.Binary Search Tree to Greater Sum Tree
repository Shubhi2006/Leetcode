class Solution {
    public static int total=0;
    public void helper(TreeNode root){
        if(root==null){
            return;
        }
        helper(root.right);
        total=total+root.val;
        root.val=total;
        helper(root.left);

    }
    public TreeNode bstToGst(TreeNode root) {
        total=0;
        helper(root);
        return root;
    }
}
