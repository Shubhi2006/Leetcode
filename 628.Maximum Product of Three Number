class Solution {
    public int maximumProduct(int[] nums) {
        Arrays.sort(nums);
        int left=0;
        int right=nums.length-1;
        int product=Math.max(nums[0]*nums[1]*nums[nums.length-1],nums[nums.length-1]*nums[nums.length-2]*nums[nums.length-3]);
        return product;
    }
}
