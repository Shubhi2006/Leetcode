class Solution {
    public static boolean isSafe(char[][]board,int row,int col,char digit){
        int count=0;
        for(int i=0;i<board.length;i++){
            if(col!=i && board[row][i]==digit){
                return false;
            }
            if(i!=row && board[i][col]==digit){
                return false;
            }
            int newrow=3*(row/3)+i/3;
            int newcol=3*(col/3)+i%3;
            if((row !=newrow || col!=newcol) && board[newrow][newcol]==digit){
                return false;
            }
        }
        
        return true;
        
    }
    public boolean solveSudoku(char[][]board){
        for(int i=0;i<board.length;i++){
            for(int j=0;j<board[0].length;j++){
                if(board[i][j]=='.'){
                    continue;
                }
                else{
                    if(!isSafe(board,i,j,board[i][j])){
                        return false;
                    }
                }

            }
        }
        return true;
    }
    public boolean isValidSudoku(char[][] board) {
        return solveSudoku(board);
    }
}
