class Solution {
    int p=0;
    public TreeNode buildUtil(int[]preorder,int []inorder,int left,int right){
        if(left>right){
            return null;
        }
        int val=preorder[p];
        p++;
        TreeNode root=new TreeNode(val);
        int pos=left;
        while(val !=inorder[pos]){
            pos++;
        }
        root.left=buildUtil(preorder,inorder,left,pos-1);
        root.right=buildUtil(preorder,inorder,pos+1,right);
        return root;


    }
    public TreeNode buildTree(int[] preorder, int[] inorder) {
       return buildUtil(preorder,inorder,0,inorder.length-1);
    }
}
