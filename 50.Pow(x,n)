
class Solution {
    public double mycal(double x, long n) {
        double result = 1.0;
        while (n > 0) {
            if (n % 2 == 1) {
                result *= x;
            }
            x *= x;
            n /= 2;
        }
        return result;
    }
    public double myPow(double x, int n) {
        long power = n;
        if (power < 0) {
            power = -power;
        }
        double result = mycal(x, power);
        if (n < 0) {
            return 1.0 / result;
        }

        return result;
    }
}
