class Solution {
    public boolean uniformArray(int[] nums1) {
        int neven=0;
        int nodd=0;
        for(int i=0;i<nums1.length;i++){
            if(nums1[i]%2==0){
                neven++;}
            else{
                nodd++;}}
        if(nodd==0 && neven>=0){
            return true;
        }
        else if(nodd>=1){
            return true;
        }
        else{
            return false;
        }
       


    }
}
