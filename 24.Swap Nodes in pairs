
class Solution {
    public ListNode swapPairs(ListNode head) {
        ListNode cur=head;
        if(cur==null || cur.next==null){
            return head;
        }
        ListNode next=cur.next;
        ListNode result=cur.next;
        ListNode prev=null;
        while(next !=null){
            ListNode temp=next.next;
            next.next=cur;
            cur.next=temp;
            prev=cur;
            cur=temp;
            next=cur.next;
        }
        return result;
    }
    
}
